{
  "name": "hhc-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @hhc/web dev",
    "dev:account": "pnpm --filter @hhc/account dev",
    "dev:admin": "pnpm --filter @hhc/admin dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test:run"
  }
}
