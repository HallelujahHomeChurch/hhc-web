# Copy this file to compose/.env.compose.local, then complete the empty values.
# This file is intentionally safe to commit. Do not commit the local copy.

POSTGRES_PASSWORD=change-me-postgres-password
ACCOUNT_DB_USER=account
ACCOUNT_DB_PASSWORD=change-me-account-password
WEB_DB_USER=hhc_web
WEB_DB_PASSWORD=change-me-web-password
ASSET_DB_USER=asset
ASSET_DB_PASSWORD=change-me-asset-password

REDIS_PASSWORD=
