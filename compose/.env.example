# acme-test.alive.org.tw validation zone.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ACME_EMAIL=
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

CLAMAV_HOST=172.16.65.5
CLAMAV_PORT=3310
ASSET_LOCAL_SIGNING_KEY=
